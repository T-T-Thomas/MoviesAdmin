@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Index";
}

<h1>Add Movies</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th><!-- Movie Poster --></th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            @*<th>
                @Html.DisplayNameFor(model => model.Summary)
            </th>*@
            <th>
                @Html.DisplayNameFor(model => model.RunTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AudienceRating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                <img src="@item.ImageUrl" alt="@item.Title" class="thumbnail" />
            </td>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            @*<td>
                @Html.DisplayFor(model => item.Summary)
            </td>*@
            <td>
                @Html.DisplayFor(model => item.RunTime)
            </td>
            <td>
                @Html.DisplayFor(model => item.Genre.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.AudienceRating.Rating)
            </td>
            <td>
                @Html.DisplayFor(model => item.ReleaseDate)
            </td>

            <td>
                @if(User.IsInRole("administrator"))
                {
                    <div>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </div>
                }
                else
                {
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
